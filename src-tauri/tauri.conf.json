{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pix",
  "version": "0.1.0",
  "identifier": "dev.pix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "companion",
        "create": false,
        "title": "Pix",
        "width": 1280,
        "height": 920,
        "minWidth": 440,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "hud",
        "create": false,
        "title": "Pix HUD",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0
      },
      {
        "label": "tabpanel",
        "create": false,
        "title": "Pix Tab panel",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "width": 168,
        "height": 234
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://lcu-asset.localhost https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
